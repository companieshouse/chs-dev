{
    "name": "chs-dev",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "bin": {
        "chs-dev": "dist/entrypoints/chs-dev.js"
    },
    "description": "Persistent local orchestration and terminal frontend for CHS development",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "dev": "node --import tsx src/entrypoints/chs-dev.ts",
        "dev:tui": "tsx watch src/entrypoints/tui.tsx",
        "build": "tsc",
        "start": "node dist/entrypoints/chs-dev.js",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
        "test:unit": "node --import tsx --test test/domain-state.test.ts test/service-dependencies.test.ts test/module-browser.test.ts test/navigation.test.ts test/enabled-tree.test.ts test/interactive-command.test.ts test/live-*.test.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:docker": "CHS_NATIVE_INTEGRATION=1 node --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
        "test:docker:mocks": "CHS_MOCK_INTEGRATION=1 node --import tsx --test test/integration/mock-providers.test.ts",
        "test:docker:chs": "CHS_NATIVE_CHS_INTEGRATION=1 node --import tsx --test --test-concurrency=1 test/integration/native-chs.test.ts test/integration/native-kafka.test.ts",
        "test:docker:platform": "CHS_NATIVE_PLATFORM_INTEGRATION=1 node --import tsx --test --test-concurrency=1 test/integration/native-platform.test.ts",
        "test:apple": "CHS_APPLE_INTEGRATION=1 node --import tsx --test --test-concurrency=1 test/integration/native-apple.test.ts test/integration/native-apple-monitoring.test.ts test/integration/native-chs.test.ts test/integration/native-kafka.test.ts test/integration/native-development.test.ts test/integration/apple-build-platform.test.ts",
        "test:compiler:parity": "CHS_COMPILER_PARITY=1 node --import tsx --test test/portable-compiler.test.ts",
        "server": "node --import tsx src/entrypoints/server.ts",
        "daemon": "node --import tsx src/entrypoints/daemon-control.ts",
        "postinstall": "node scripts/prepare-native.mjs",
        "lint": "eslint src test scripts eslint.config.mjs",
        "complexity:report": "node scripts/complexity.mjs report",
        "indent:report": "node scripts/indentation.mjs",
        "length:report": "node scripts/file-length.mjs",
        "complexity:json": "node scripts/complexity.mjs json",
        "complexity:check": "node scripts/complexity.mjs check",
        "complexity:baseline": "node scripts/complexity.mjs baseline",
        "test:complexity": "node --test test/complexity-tooling.test.mjs test/combined-nesting.test.mjs",
        "tui:preview": "node --import tsx scripts/tui-preview.ts",
        "lint:fix": "npm run lint -- --fix",
        "check": "npm run format:check && npm run lint && npm run complexity:check && npm run typecheck"
    },
    "dependencies": {
        "fs-ext": "^2.1.1",
        "ink": "^7.1.1",
        "node-pty": "^1.1.0",
        "react": "^19.3.0",
        "wrap-ansi": "^10.0.2",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@babel/core": "^8.0.6",
        "@babel/eslint-parser": "^8.0.6",
        "@types/fs-ext": "^2.0.3",
        "@types/node": "^22.20.4",
        "@types/react": "^19.3.0",
        "eslint": "^10.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "overrides": {
        "ink": {
            "react-reconciler": "0.34.0"
        }
    }
}
